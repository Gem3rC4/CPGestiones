+/** Campo de contraseña con botón de ojo para mostrar u ocultar lo escrito. */
+export function PasswordField({ label, hint, error, className = '', ...rest }: Omit<FieldProps, 'type'>) {
+  const id = useId();
+  const [visible, setVisible] = useState(false);
+  return (
+    <div>
+      <label htmlFor={id} className="block text-sm font-semibold text-ink">
+        {label}
+      </label>
+      <div className="relative">
+        <input
+          id={id}
+          type={visible ? 'text' : 'password'}
+          aria-invalid={!!error}
+          aria-describedby={error || hint ? `${id}-d` : undefined}
+          {...rest}
+          className={`${BASE} pr-12 ${error ? 'border-rojo' : 'border-line'} ${className}`}
+        />
+        <button
+          type="button"
+          onClick={() => setVisible((v) => !v)}
+          aria-label={visible ? 'Ocultar contraseña' : 'Mostrar contraseña'}
+          aria-pressed={visible}
+          className="absolute inset-y-0 right-1 mt-1.5 grid w-10 place-items-center rounded-lg text-muted hover:text-ink focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-600/40"
+        >
+          {visible ? <EyeOffIcon width={20} height={20} /> : <EyeIcon width={20} height={20} />}
+        </button>
+      </div>
+      {(error || hint) && (
+        <p id={`${id}-d`} className={`mt-1 text-xs ${error ? 'text-rojo' : 'text-muted'}`}>
+          {error ?? hint}
+        </p>
+      )}
+    </div>
+  );
+}
