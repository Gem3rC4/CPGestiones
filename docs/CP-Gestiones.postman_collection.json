  "item": [
    {
      "name": "alertas",
      "item": [
        {
          "name": "GET /alertas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/alertas",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Solo empleados con permiso de clientes, cuentas o gestiones; filtro por permiso. Paginación de 25. Cada alerta incluye id, titulo, mensaje, recurso, recurso_id, created_at y leida para el empleado. Polling del panel cada 5 segundos."
          }
        },
        {
          "name": "POST /alertas/leidas",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/alertas/leidas",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Marca solo los IDs visibles indicados y autorizados. Lectura individual por empleado; repetir es seguro. No marca alertas recibidas posteriormente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [\n    \"{{alerta_id}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "auth",
      "item": [
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Consulta o gestión de auth",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"token\", pm.response.json().data.token); }"
                ]
              }
            }
          ]
        },
